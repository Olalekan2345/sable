# =============================================================================
# Sable — environment configuration
#
# Copy to `.env` and fill in. Never commit a populated `.env`.
#
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything
# else stays server-side. A deployer key must never carry a NEXT_PUBLIC_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Web application (browser-visible)
# -----------------------------------------------------------------------------

# Ethereum Sepolia. Sable requires a chain with the Zama coprocessor deployed.
NEXT_PUBLIC_CHAIN_ID=11155111

# Optional. Falls back to a public endpoint. A dedicated RPC is strongly
# recommended: the activity view issues log queries that public nodes rate-limit.
NEXT_PUBLIC_RPC_URL=

# Optional. How far back the activity view scans, in blocks. Default 20,000
# (roughly three days of Sepolia).
#
# Not anchored to the vault's deployment block, because two of the three contracts
# it reads are Zama's and existed long before Sable — your approvals and shielding
# on them are your history regardless of when this vault was deployed.
#
# A public endpoint has to walk the range in 1,000-block windows, so a wider setting
# costs requests. A dedicated endpoint answers the whole range in one and is
# unaffected; raise this if you have one and want more history.
NEXT_PUBLIC_ACTIVITY_LOOKBACK_BLOCKS=

# Optional. Turns on Reown AppKit as the wallet chooser.
#
# With an id: several hundred wallets, mobile deep links and QR pairing for phone
# wallets. Without one: Sable falls back to its own EIP-6963 picker, which lists
# every installed browser extension by name and needs no external service. The app
# connects wallets either way — nobody hits a dead end for lack of an account.
#
# A project id is public by design; it ships in the browser bundle and is not a
# secret. Get a free one at https://cloud.reown.com and use your own rather than an
# id copied from a tutorial: usage is billed and rate-limited against its owner's
# project, and it can be revoked without warning.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses.
#
# Leave blank after running `pnpm deploy:sepolia && pnpm sync:abis` — the app
# reads the generated deployment record automatically. Set them only to point a
# build at a different deployment without regenerating.
#
# On Sepolia the confidential asset defaults to Zama's published cUSDCMock
# (0x7c5BF43B851c1dff1a4feE8dB225b87f2C223639). Sable does not deploy its own
# asset there; override only to custody a different ERC-7984.
#
# If these are absent AND no deployment record exists, the app renders its
# "not deployed" state. It never falls back to placeholder addresses.
NEXT_PUBLIC_SABLE_ADDRESS=
NEXT_PUBLIC_CONFIDENTIAL_ASSET_ADDRESS=
NEXT_PUBLIC_YIELD_ADAPTER_ADDRESS=

# -----------------------------------------------------------------------------
# Contract deployment (server-side only — NEVER expose)
# -----------------------------------------------------------------------------

# Deployer key. Use a throwaway testnet account funded with Sepolia ETH.
# Holds ADMIN_ROLE and the yield reserve. Signs deployment and round configuration.
DEPLOYER_PRIVATE_KEY=

# Keeper key. Optional, and only for running `hardhat keeper` locally as the keeper rather
# than as the deployer.
#
# Advancing a round is permissionless, so this account needs gas and nothing else — no role,
# no ownership, no access to the reserve. That is what makes it safe to run unattended.
#
# The scheduled keeper does NOT read this file. GitHub Actions cannot see a gitignored .env,
# so the CI keeper takes its key from the KEEPER_PRIVATE_KEY repository secret:
#
#     gh secret set KEEPER_PRIVATE_KEY --repo <owner>/<repo>
#
KEEPER_PRIVATE_KEY=0x6d9b9b34979e7647f19973f07dbd0dfb5ba38fe0be7e08134b855823c8e30780

# A dedicated endpoint is worth having for anything that writes: publicnode drops sockets
# partway through a run of transactions.
SEPOLIA_RPC_URL=https://11155111.rpc.thirdweb.com

# For `pnpm verify:sepolia`.
ETHERSCAN_API_KEY=

# Set to "true" to print a gas report during contract tests.
REPORT_GAS=false

# -----------------------------------------------------------------------------
# Indexer (optional)
#
# The indexer archives PUBLIC round metadata only. It stores no balances, modes,
# weights or rewards — the schema has no columns for them. The web app works
# fully without it.
# -----------------------------------------------------------------------------

DATABASE_URL=postgres://postgres:postgres@localhost:5432/sable

# Defaults to the generated deployment record when omitted.
SABLE_ADDRESS=
START_BLOCK=

BLOCK_RANGE=5000
POLL_INTERVAL=15
CONFIRMATIONS=2
PORT=4000
