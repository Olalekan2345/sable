{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": false,
    "noEmit": true,
    "types": ["node", "mocha", "chai", "chai-as-promised"]
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "tasks/**/*.ts", "test/**/*.ts", "types/**/*.ts"]
}
